<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- 主内容区 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="false" />

        <!-- 透明手势层，覆盖在画面上 -->
        <com.easylive.player.player.GestureOverlay
            android:id="@+id/gestureOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/brightnessHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="12dp"
            android:textSize="28sp"
            android:textColor="@color/text_primary"
            android:background="#AA000000"
            android:visibility="gone" />

        <TextView
            android:id="@+id/errorTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="16dp"
            android:textSize="20sp"
            android:textColor="#FF6666"
            android:visibility="gone" />

        <!-- 底部控制条 -->
        <LinearLayout
            android:id="@+id/controlBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:background="#99000000"
            android:visibility="gone">

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:text="@string/ctl_settings"
                android:textSize="22sp"
                android:textColor="@color/text_primary"
                android:background="?attr/selectableItemBackground" />

            <Button
                android:id="@+id/btnChannels"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:text="@string/ctl_channels"
                android:textSize="22sp"
                android:textColor="@color/text_primary"
                android:background="?attr/selectableItemBackground" />

            <Button
                android:id="@+id/btnLock"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:text="@string/ctl_lock"
                android:textSize="22sp"
                android:textColor="@color/text_primary"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>

        <!-- 锁定态下的解锁入口 -->
        <Button
            android:id="@+id/lockBadge"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:text="锁"
            android:textSize="22sp"
            android:textColor="@color/text_primary"
            android:background="#AA335577FF"
            android:visibility="gone" />

        <!-- 空状态 -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_title"
                android:textSize="28sp"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/empty_desc"
                android:textSize="18sp"
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/emptyGoSettings"
                android:layout_width="wrap_content"
                android:layout_height="72dp"
                android:layout_marginTop="20dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/empty_go_settings"
                android:textSize="22sp"
                android:textColor="@color/text_primary"
                android:background="#AA335577FF" />
        </LinearLayout>
    </FrameLayout>

    <!-- 右侧抽屉：频道列表 -->
    <LinearLayout
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/panel"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="@string/drawer_title"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            android:background="#22000000" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channelRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
